{
  "name": "BusinessSurvey",
  "type": "object",
  "properties": {
    "business_stage": {
      "type": "string",
      "enum": [
        "exploring_idea",
        "actively_planning",
        "looking_for_property",
        "under_contract",
        "ready_to_open",
        "already_open"
      ],
      "description": "Where the user is in the process"
    },
    "has_property": {
      "type": "string",
      "enum": [
        "looking_need_help",
        "looking_no_help",
        "dont_need_property",
        "in_mind",
        "secured"
      ],
      "description": "Property status"
    },
    "jurisdiction": {
      "type": "string",
      "enum": [
        "vero_beach",
        "sebastian",
        "fellsmere",
        "indian_river_county",
        "unsure"
      ],
      "description": "Which city/county the property is in"
    },
    "needs_construction": {
      "type": "string",
      "enum": [
        "no",
        "minor",
        "major_renovation",
        "new_construction",
        "not_sure"
      ],
      "description": "Whether construction or renovations are needed"
    },
    "business_type": {
      "type": "string",
      "enum": [
        "agriculture",
        "professional_services",
        "retail",
        "hotel_boardinghouse",
        "personal_services",
        "business_services",
        "auto",
        "misc_repair",
        "motion_pictures",
        "amusement_recreation",
        "medical",
        "food_store",
        "auto_dealer",
        "eating_drinking",
        "educational",
        "institutional",
        "industrial",
        "transportation",
        "home_based",
        "mobile_food_truck",
        "mobile_pop_up",
        "mobile_catering",
        "mobile_personal_services",
        "mobile_medical_services",
        "non_profit"
      ],
      "description": "Type of business"
    },
    "business_structure": {
      "type": "string",
      "enum": [
        "no_reach_out",
        "no_research_myself",
        "sole_proprietor",
        "partnership",
        "llc",
        "c_corp",
        "s_corp",
        "nonprofit",
        "other"
      ],
      "description": "Planned business structure"
    },
    "funding_needs": {
      "type": "string",
      "enum": [
        "no",
        "exploring_options",
        "actively_applying"
      ],
      "description": "Funding situation"
    },
    "is_woman_owned": {
      "type": "boolean",
      "description": "Whether business is woman-owned"
    },
    "is_veteran_owned": {
      "type": "boolean",
      "description": "Whether business is veteran-owned"
    },
    "is_minority_owned": {
      "type": "boolean",
      "description": "Whether business is minority-owned"
    },
    "is_first_time_owner": {
      "type": "boolean",
      "description": "Whether this is the user's first business"
    },
    "has_employees": {
      "type": "string",
      "enum": [
        "no",
        "yes_1_9",
        "yes_10_50",
        "yes_50_plus"
      ],
      "description": "Anticipated number of employees"
    },
    "help_level": {
      "type": "string",
      "enum": [
        "free_checklist",
        "step_by_step",
        "review_situation",
        "full_concierge"
      ],
      "description": "Level of help desired"
    },
    "email": {
      "type": "string",
      "description": "Contact email"
    },
    "full_name": {
      "type": "string",
      "description": "Full name"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "plan_type": {
      "type": "string",
      "enum": [
        "free",
        "premium"
      ],
      "default": "free",
      "description": "Free or premium checklist"
    },
    "checklist_progress": {
      "type": "object",
      "description": "Tracks completion of checklist items"
    }
  },
  "required": [
    "business_stage",
    "business_type"
  ]
}