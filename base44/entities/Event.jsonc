{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Event title"
    },
    "description": {
      "type": "string",
      "description": "Event description"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "networking",
        "workshop",
        "seminar",
        "government",
        "other"
      ],
      "description": "Type of event"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Event date"
    },
    "start_time": {
      "type": "string",
      "description": "Start time (e.g. 9:00 AM)"
    },
    "end_time": {
      "type": "string",
      "description": "End time (e.g. 11:00 AM)"
    },
    "location": {
      "type": "string",
      "description": "Venue or address"
    },
    "is_virtual": {
      "type": "boolean",
      "default": false
    },
    "registration_url": {
      "type": "string",
      "description": "Link to register"
    },
    "organizer": {
      "type": "string",
      "description": "Organizing body or person"
    },
    "is_free": {
      "type": "boolean",
      "default": true
    },
    "cost": {
      "type": "string",
      "description": "Cost if not free"
    }
  },
  "required": [
    "title",
    "date",
    "event_type"
  ]
}