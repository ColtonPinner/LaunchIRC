{
  "name": "DirectoryListing",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "Name of the service provider"
    },
    "category": {
      "type": "string",
      "enum": [
        "attorney",
        "accountant_cpa",
        "real_estate",
        "insurance",
        "banking_lending",
        "contractor",
        "architect",
        "marketing",
        "it_services",
        "permits_consulting",
        "other"
      ],
      "description": "Service category"
    },
    "description": {
      "type": "string",
      "description": "Brief description of services"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "is_sponsor": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a paying sponsor"
    },
    "sponsor_level": {
      "type": "string",
      "enum": [
        "none",
        "bronze",
        "silver",
        "gold",
        "platinum"
      ],
      "default": "none"
    },
    "sponsored_sections": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Which sections/pages they sponsor"
    },
    "is_approved": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "company_name",
    "category"
  ]
}